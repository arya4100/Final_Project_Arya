{
  "info": {
    "name": "SmartStock — full CRUD, security and push",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against a seeded local server. Actual push delivery requires a browser subscription. No secrets are embedded."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login manager",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"manager@smartstock.demo\",\n  \"password\": \"SmartStock!2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token',pm.response.json().token);"
            ]
          }
        }
      ]
    },
