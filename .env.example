PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=smartstock
# Persistent local MongoDB replica set, bound only to loopback.
LOCAL_DATABASE=true
LOCAL_DATABASE_PATH=.data/mongodb
LOCAL_DATABASE_PORT=27028
# Tests override this to true to use disposable databases.
DEMO_DATABASE=false
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SEED_DEMO=true
